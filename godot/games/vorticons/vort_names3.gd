static func sprites() -> Dictionary:
	var out: Dictionary = {}
	for i: int in range(SPRITE_NAMES.size()):
		out[SPRITE_NAMES[i]] = i
	out["NUMSPRITES"] = SPRITE_NAMES.size()
	return out


## Sound numbers start at 1 (entry 0 of the file is its header).
static func sounds() -> Dictionary:
	var out: Dictionary = {}
	for i: int in range(SOUND_NAMES.size()):
		out[SOUND_NAMES[i]] = i + 1
	return out
